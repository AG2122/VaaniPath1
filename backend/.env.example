[TEMPLATE]
# ============================================================================
# VaniPath Backend Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================================

# Application
APP_NAME=VaniPath
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# -- Database ---------------------------------------------------------------
# Local development (SQLite):
DATABASE_URL=sqlite:///./vanipath.db
#
# Production (Supabase PostgreSQL Shared Session Pooler):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# -- Supabase ---------------------------------------------------------------
# Find these at: https://app.supabase.com > Project Settings > API
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=       # anon/public key (safe for frontend)
SUPABASE_SECRET_KEY=            # service_role key (NEVER expose to frontend)

# -- JWT Authentication ------------------------------------------------------
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -- Translation -------------------------------------------------------------
TRANSLATION_MODEL=local
ENABLE_AI_TRANSLATION=false
AI_TRANSLATION_API_KEY=

# -- Speech ------------------------------------------------------------------
STT_PROVIDER=local
TTS_PROVIDER=local
AUDIO_CACHE_DIR=./data/audio

# -- Online TTS (for prototype online mode) ---------------------------------
# No production Santali TTS API exists. Edge TTS is used as a prototype
# provider. Set to "edge" to use Edge TTS (requires internet).
# Set to "none" to disable online TTS entirely.
ONLINE_TTS_PROVIDER=edge
ONLINE_TTS_VOICE=hi-IN-SwaraNeural

# -- CORS -------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]

# -- Rate Limiting -----------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60

# -- File Upload -------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10
ALLOWED_AUDIO_FORMATS=wav,mp3,ogg,m4a
